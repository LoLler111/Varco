<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rigenera assets/varco.ico e le anteprime PNG dal disegno in src/Varco.Tray/VarcoIcon.cs
       (comando: dotnet run, opzione project, cartella tools/Varco.IconGen) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Varco.Tray\VarcoIcon.cs" Link="VarcoIcon.cs" />
  </ItemGroup>
</Project>
